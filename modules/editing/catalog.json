{
  "version": 1,
  "note": "El banco de efectos del motor de edits. stage=output: un Event de la EDL en tiempo de SALIDA (pasada 2). stage=source: un campo del Segment, sobre los cuadros de la fuente (pasada 1). level: cuánta intensidad aporta (1 suave … 5 máximo; lo usan los bloques). from_map: de qué dato del mapa de movimiento sale por omisión. typical_frames: duración típica a 30 fps.",
  "effects": [
    {"id": "flash", "stage": "output", "level": 3,
     "description": "Destello que blanquea y se apaga (pulso cuadrático).",
     "params": {"intensity": {"default": 1.0, "min": 0, "max": 1.5}, "dur": {"default": 0.18, "min": 0.03, "max": 1.0}},
     "typical_frames": [3, 6], "trigger": {"music": "inicio de compás, golpe de la letra", "video": "impact (destello propio)"}},
    {"id": "flash_mix", "stage": "output", "level": 3, "event": "flash", "fixed": {"shape": "mix"},
     "description": "Destello plano: el cuadro mezclado con blanco una cantidad fija durante toda su duración (el 55 % por 0.07 s del edit 3).",
     "params": {"intensity": {"default": 0.55, "min": 0.05, "max": 1.0}, "dur": {"default": 0.07, "min": 0.03, "max": 0.5}},
     "typical_frames": [2, 3], "trigger": {"music": "inicio de frase", "video": "corte o golpe"}},
    {"id": "zoom", "stage": "output", "level": 3,
     "description": "Golpe de zoom (12 % a intensidad 1) que vuelve; apunta a un punto.",
     "params": {"intensity": {"default": 1.0, "min": 0, "max": 1.5}, "dur": {"default": 0.18, "min": 0.05, "max": 1.0},
                "x": {"default": 0.5, "from_map": "focus_at(t).cx"}, "y": {"default": 0.5, "from_map": "focus_at(t).cy"},
                "attack": {"default": 0.04, "min": 0, "max": 0.5}},
     "typical_frames": [5, 8], "trigger": {"music": "beat fuerte", "video": "impact"}},
    {"id": "shake", "stage": "output", "level": 4,
     "description": "Sacudida a 13 Hz que decae. Con ángulo, solo en el eje del golpe y empezando hacia donde va.",
     "params": {"intensity": {"default": 0.6, "min": 0, "max": 1.5}, "dur": {"default": 0.3, "min": 0.08, "max": 1.0},
                "angle": {"default": null, "from_map": "impact.angle"}, "decay": {"default": 2.0, "min": 0.5, "max": 4}},
     "typical_frames": [6, 12], "trigger": {"music": "golpe del bajo", "video": "impact"}},
    {"id": "rgb", "stage": "output", "level": 3,
     "description": "Separación de rojo y azul (glitch) mientras dura.",
     "params": {"intensity": {"default": 1.0, "min": 0, "max": 1.5}, "dur": {"default": 0.12, "min": 0.03, "max": 1.0}},
     "typical_frames": [3, 6], "trigger": {"music": "drop, corte del coro", "video": "smear"}},
    {"id": "push", "stage": "output", "level": 1,
     "description": "Acercamiento lento hasta 1+level durante dur.",
     "params": {"level": {"default": 0.08, "min": 0.01, "max": 0.4}, "dur": {"default": 2.0, "min": 0.3, "max": 10},
                "x": {"default": 0.5, "from_map": "focus_at(t).cx"}, "y": {"default": 0.5, "from_map": "focus_at(t).cy"}},
     "typical_frames": [30, 120], "trigger": {"music": "verso, calma", "video": "calm"}},
    {"id": "hold", "stage": "output", "level": 2,
     "description": "Zoom sostenido en 1+level (un escalón de zoom en escalera).",
     "params": {"level": {"default": 0.15, "min": 0.02, "max": 0.6}, "dur": {"default": 0.45, "min": 0.1, "max": 4},
                "attack": {"default": 0.0}, "x": {"default": 0.5, "from_map": "focus_at(t).cx"},
                "y": {"default": 0.5, "from_map": "focus_at(t).cy"}},
     "typical_frames": [10, 30], "trigger": {"music": "cada beat de un compás", "video": "impact en ráfaga"}},
    {"id": "whip", "stage": "output", "level": 4,
     "description": "Transición: golpe de zoom con desenfoque de movimiento. Con ángulo, el cuadro sale disparado hacia allá y el desenfoque va en su eje (horizontal o vertical: gblur no hace otros).",
     "params": {"intensity": {"default": 1.0, "min": 0, "max": 1.5}, "dur": {"default": 0.2, "min": 0.08, "max": 0.6},
                "angle": {"default": null, "from_map": "impact.angle | pan.angle"}},
     "typical_frames": [5, 8], "trigger": {"music": "cambio de sección", "video": "pan, smear"}},
    {"id": "black", "stage": "output", "level": 2,
     "description": "Cuadro negro (el silencio antes del drop).",
     "params": {"dur": {"default": 0.3, "min": 0.03, "max": 2.0}},
     "typical_frames": [6, 12], "trigger": {"music": "silencio antes del drop", "video": "cut"}},
    {"id": "panel", "stage": "output", "level": 2,
     "description": "Panel de manga sobre el cuadro congelado: el fondo a ×0.62, el panel de 93 % a 100 % en 0.12 s y +3.5 % hasta el final.",
     "params": {"image": {"default": ""}, "dur": {"default": 0.92, "note": "2 tiempos"}, "dim": {"default": 0.62},
                "enter": {"default": 0.12}, "from_scale": {"default": 0.93}, "drift": {"default": 0.035}},
     "typical_frames": [27, 28], "trigger": {"music": "2 tiempos en una frase clave", "video": "pose (pareja panel–escena)"}},
    {"id": "invert", "stage": "output", "level": 4,
     "description": "El negativo del cuadro, por número de cuadro.",
     "params": {"dur": {"default": 0.07, "min": 0.03, "max": 1.0}},
     "typical_frames": [1, 3], "trigger": {"music": "golpe seco", "video": "impact (cuadro de impacto)"}},
    {"id": "strobe", "stage": "output", "level": 5,
     "description": "Estrobo: un cuadro blanco (mezclado por intensity) cada `every` cuadros.",
     "params": {"intensity": {"default": 0.8, "min": 0.1, "max": 1.0}, "dur": {"default": 0.5, "min": 0.1, "max": 3.0},
                "every": {"default": 2, "min": 2, "max": 8}},
     "typical_frames": [12, 30], "trigger": {"music": "subida antes del drop", "video": "ráfaga de golpes"}},
    {"id": "glow", "stage": "output", "level": 3,
     "description": "Pulso de brillo (bloom): el cuadro difuminado sumado en modo pantalla, que crece y se apaga.",
     "params": {"intensity": {"default": 1.0, "min": 0, "max": 1.5}, "dur": {"default": 0.4, "min": 0.1, "max": 2.0},
                "attack": {"default": 0.03}},
     "typical_frames": [8, 15], "trigger": {"music": "nota larga, drop", "video": "flash, glow del personaje"}},
    {"id": "follow", "stage": "output", "level": 1,
     "description": "Una imagen (un logo) que sigue al personaje cuadro a cuadro: el pecho rastreado con los detectores ONNX de deepghs (motion.subject). Termina en el primer corte de la fuente.",
     "params": {"image": {"default": ""}, "track": {"from_map": "subject.track(path, a, b, hint)"},
                "opacity": {"default": 0.93}, "fade": {"default": 0.12}},
     "typical_frames": [15, 60], "trigger": {"music": "", "video": "un personaje en plano"}},
    {"id": "ramp", "stage": "source", "level": 3, "field": "pieces (timing.hit_ramp)",
     "description": "Rampa de velocidad: rápido hacia el golpe y lento después, con el cuadro del golpe exacto en su beat. Con RIFE (si está) y dedupe, la parte lenta se interpola entre dibujos distintos.",
     "params": {"hit_out": {"from_map": "impact.f → beat"}, "before": {"default": "constant"}, "after": {"default": "breathe"}},
     "typical_frames": [15, 45], "trigger": {"music": "golpe en un beat", "video": "impact"}},
    {"id": "mblur", "stage": "source", "level": 2, "field": "Segment.mblur",
     "description": "Desenfoque de movimiento en cualquier ángulo (gira, desenfoca en horizontal y vuelve): en todo el plano.",
     "params": {"angle": {"default": 0, "from_map": "impact.angle | smear.angle"}, "amount": {"default": 24, "min": 1, "max": 200}},
     "typical_frames": [4, 12], "trigger": {"music": "barrido", "video": "smear"}},
    {"id": "dedupe", "stage": "source", "level": 0, "field": "Segment.dedupe",
     "description": "Con RIFE: quita los dibujos repetidos (anime en dos o tres) antes de interpolar.",
     "params": {}, "typical_frames": [0, 0], "trigger": {"music": "", "video": "held_ratio alto"}}
  ]
}
