{
  "version": 1,
  "note": "El banco de efectos del motor de edits. stage=output: un Event de la EDL en tiempo de SALIDA (pasada 2). stage=source: un campo del Segment, sobre los cuadros de la fuente (pasada 1). level: cuánta intensidad aporta (1 suave … 5 máximo; lo usan los bloques). from_map: de qué dato del mapa de movimiento sale por omisión. typical_frames: duración típica a 30 fps.",
  "effects": [
    {"id": "flash", "stage": "output", "level": 3,
     "description": "Destello que blanquea y se apaga (pulso cuadrático).",
     "params": {"intensity": {"default": 1.0, "min": 0, "max": 1.5}, "dur": {"default": 0.18, "min": 0.03, "max": 1.0}},
     "typical_frames": [3, 6], "trigger": {"music": "inicio de compás, golpe de la letra", "video": "impact (destello propio)"}},
    {"id": "flash_mix", "stage": "output", "level": 3, "event": "flash", "fixed": {"shape": "mix"},
     "description": "Destello plano: el cuadro mezclado con blanco una cantidad fija durante toda su duración (el 55 % por 0.07 s del edit 3).",
     "params": {"intensity": {"default": 0.55, "min": 0.05, "max": 1.0}, "dur": {"default": 0.07, "min": 0.03, "max": 0.5}},
     "typical_frames": [2, 3], "trigger": {"music": "inicio de frase", "video": "corte o golpe"}},
    {"id": "zoom", "stage": "output", "level": 3,
     "description": "Golpe de zoom (12 % a intensidad 1) que vuelve; apunta a un punto.",
     "params": {"intensity": {"default": 1.0, "min": 0, "max": 1.5}, "dur": {"default": 0.18, "min": 0.05, "max": 1.0},
                "x": {"default": 0.5, "from_map": "focus_at(t).cx"}, "y": {"default": 0.5, "from_map": "focus_at(t).cy"},
                "attack": {"default": 0.04, "min": 0, "max": 0.5}},
     "typical_frames": [5, 8], "trigger": {"music": "beat fuerte", "video": "impact"}},
    {"id": "shake", "stage": "output", "level": 4,
     "description": "Sacudida a 13 Hz que decae. Con ángulo, solo en el eje del golpe y empezando hacia donde va.",
     "params": {"intensity": {"default": 0.6, "min": 0, "max": 1.5}, "dur": {"default": 0.3, "min": 0.08, "max": 1.0},
                "angle": {"default": null, "from_map": "impact.angle"}, "decay": {"default": 2.0, "min": 0.5, "max": 4}},
     "typical_frames": [6, 12], "trigger": {"music": "golpe del bajo", "video": "impact"}},
    {"id": "rgb", "stage": "output", "level": 3,
     "description": "Separación de rojo y azul (glitch) mientras dura.",
     "params": {"intensity": {"default": 1.0, "min": 0, "max": 1.5}, "dur": {"default": 0.12, "min": 0.03, "max": 1.0}},
     "typical_frames": [3, 6], "trigger": {"music": "drop, corte del coro", "video": "smear"}},
    {"id": "push", "stage": "output", "level": 1,
     "description": "Acercamiento lento hasta 1+level durante dur.",
     "params": {"level": {"default": 0.08, "min": 0.01, "max": 0.4}, "dur": {"default": 2.0, "min": 0.3, "max": 10},
                "x": {"default": 0.5, "from_map": "focus_at(t).cx"}, "y": {"default": 0.5, "from_map": "focus_at(t).cy"}},
     "typical_frames": [30, 120], "trigger": {"music": "verso, calma", "video": "calm"}},
    {"id": "hold", "stage": "output", "level": 2,
     "description": "Zoom sostenido en 1+level (un escalón de zoom en escalera).",
     "params": {"level": {"default": 0.15, "min": 0.02, "max": 0.6}, "dur": {"default": 0.45, "min": 0.1, "max": 4},
                "attack": {"default": 0.0}, "x": {"default": 0.5, "from_map": "focus_at(t).cx"},
                "y": {"default": 0.5, "from_map": "focus_at(t).cy"}},
     "typical_frames": [10, 30], "trigger": {"music": "cada beat de un compás", "video": "impact en ráfaga"}},
    {"id": "whip", "stage": "output", "level": 4,
     "description": "Transición: golpe de zoom con desenfoque de movimiento. Con ángulo, el cuadro sale disparado hacia allá y el desenfoque va en su eje (horizontal o vertical: gblur no hace otros).",
     "params": {"intensity": {"default": 1.0, "min": 0, "max": 1.5}, "dur": {"default": 0.2, "min": 0.08, "max": 0.6},
                "angle": {"default": null, "from_map": "impact.angle | pan.angle"}},
     "typical_frames": [5, 8], "trigger": {"music": "cambio de sección", "video": "pan, smear"}},
    {"id": "black", "stage": "output", "level": 2,
     "description": "Cuadro negro (el silencio antes del drop).",
     "params": {"dur": {"default": 0.3, "min": 0.03, "max": 2.0}},
     "typical_frames": [6, 12], "trigger": {"music": "silencio antes del drop", "video": "cut"}},
    {"id": "panel", "stage": "output", "level": 2,
     "description": "Panel de manga sobre el cuadro congelado: el fondo a ×0.62, el panel de 93 % a 100 % en 0.12 s y +3.5 % hasta el final.",
     "params": {"image": {"default": ""}, "dur": {"default": 0.92, "note": "2 tiempos"}, "dim": {"default": 0.62},
                "enter": {"default": 0.12}, "from_scale": {"default": 0.93}, "drift": {"default": 0.035}},
     "typical_frames": [27, 28], "trigger": {"music": "2 tiempos en una frase clave", "video": "pose (pareja panel–escena)"}},
    {"id": "invert", "stage": "output", "level": 4,
     "description": "El negativo del cuadro, por número de cuadro.",
     "params": {"dur": {"default": 0.07, "min": 0.03, "max": 1.0}},
     "typical_frames": [1, 3], "trigger": {"music": "golpe seco", "video": "impact (cuadro de impacto)"}},
    {"id": "strobe", "stage": "output", "level": 5,
     "description": "Estrobo: un cuadro blanco (mezclado por intensity) cada `every` cuadros.",
     "params": {"intensity": {"default": 0.8, "min": 0.1, "max": 1.0}, "dur": {"default": 0.5, "min": 0.1, "max": 3.0},
                "every": {"default": 2, "min": 2, "max": 8}},
     "typical_frames": [12, 30], "trigger": {"music": "subida antes del drop", "video": "ráfaga de golpes"}},
    {"id": "glow", "stage": "output", "level": 3,
     "description": "Pulso de brillo (bloom): el cuadro difuminado sumado en modo pantalla, que crece y se apaga.",
     "params": {"intensity": {"default": 1.0, "min": 0, "max": 1.5}, "dur": {"default": 0.4, "min": 0.1, "max": 2.0},
                "attack": {"default": 0.03}},
     "typical_frames": [8, 15], "trigger": {"music": "nota larga, drop", "video": "flash, glow del personaje"}},
    {"id": "follow", "stage": "output", "level": 1,
     "description": "Una imagen (un logo) que sigue al personaje cuadro a cuadro: el pecho rastreado con los detectores ONNX de deepghs (motion.subject). Termina en el primer corte de la fuente.",
     "params": {"image": {"default": ""}, "track": {"from_map": "subject.track(path, a, b, hint)"},
                "opacity": {"default": 0.93}, "fade": {"default": 0.12}},
     "typical_frames": [15, 60], "trigger": {"music": "", "video": "un personaje en plano"}},
    {"id": "speedlines", "stage": "output", "level": 3, "description": "Líneas de velocidad de anime (radiales): cuñas blancas desde fuera del cuadro hacia un punto, con un círculo limpio alrededor. Se redibujan en cada cuadro (titilan como las dibujadas).", "params": {"intensity": {"default": 1.0, "min": 0.2, "max": 1.5}, "dur": {"default": 0.3, "min": 0.07, "max": 2.0}, "x": {"default": 0.5, "from_map": "focus_at(t).cx"}, "y": {"default": 0.5, "from_map": "focus_at(t).cy"}, "fade": {"default": 0.12, "min": 0, "max": 0.5}, "seed": {"default": 0}}, "typical_frames": [6, 20], "trigger": {"music": "subida, golpe del drop", "video": "impact o carga antes del golpe"}},
    {"id": "speedlines_parallel", "stage": "output", "level": 3, "event": "speedlines", "fixed": {"style": "parallel"}, "description": "Líneas de velocidad paralelas: trazos a lo largo de la dirección del movimiento (un personaje que corre o vuela).", "params": {"intensity": {"default": 1.0, "min": 0.2, "max": 1.5}, "dur": {"default": 0.4, "min": 0.07, "max": 2.0}, "angle": {"default": 0, "from_map": "smear.angle | pan.angle"}, "fade": {"default": 0.12}, "seed": {"default": 0}}, "typical_frames": [8, 30], "trigger": {"music": "tramo rápido", "video": "smear, pan"}},
    {"id": "impactframe", "stage": "output", "level": 5, "fixed": {"style": "bw"}, "description": "Cuadro de impacto: el cuadro redibujado en dos tonos, tinta negra sobre papel blanco (umbral de luma), sin color.", "params": {"dur": {"default": 0.07, "min": 0.03, "max": 0.3}}, "typical_frames": [1, 3], "trigger": {"music": "golpe del drop", "video": "impact (el cuadro del contacto)"}},
    {"id": "impactframe_inv", "stage": "output", "level": 5, "event": "impactframe", "fixed": {"style": "inv"}, "description": "Cuadro de impacto invertido: blanco sobre negro, dos tonos.", "params": {"dur": {"default": 0.07, "min": 0.03, "max": 0.3}}, "typical_frames": [1, 3], "trigger": {"music": "golpe del drop", "video": "impact"}},
    {"id": "impactframe_poster", "stage": "output", "level": 4, "event": "impactframe", "fixed": {"style": "poster"}, "description": "Cuadro de impacto posterizado: 4 o 5 grises planos.", "params": {"dur": {"default": 0.1, "min": 0.03, "max": 0.3}}, "typical_frames": [2, 4], "trigger": {"music": "golpe", "video": "impact"}},
    {"id": "spin", "stage": "output", "level": 5, "description": "Giro del cuadro entero con aceleración y frenado suaves (smoothstep), con bordes espejados: nunca esquinas negras. Negativo = antihorario.", "params": {"dur": {"default": 0.3, "min": 0.1, "max": 1.5}, "degrees": {"default": 360, "min": -1080, "max": 1080}}, "typical_frames": [6, 15], "trigger": {"music": "transición entre frases, subida", "video": "corte"}},
    {"id": "zoomblur", "stage": "output", "level": 4, "description": "Zoom radial: 6 copias del cuadro escaladas hasta +16 % (a intensidad 1) mezcladas, como un golpe de zoom con desenfoque.", "params": {"intensity": {"default": 1.0, "min": 0.2, "max": 1.5}, "dur": {"default": 0.2, "min": 0.03, "max": 1.0}}, "typical_frames": [3, 8], "trigger": {"music": "golpe, entrada del drop", "video": "impact"}},
    {"id": "glitch", "stage": "output", "level": 4, "fixed": {"style": "blocks"}, "description": "Glitch de bloques: 5 franjas horizontales corridas de lado (desplazamiento pseudoaleatorio por cuadro) y croma separada.", "params": {"intensity": {"default": 1.0, "min": 0.2, "max": 1.5}, "dur": {"default": 0.2, "min": 0.03, "max": 1.0}, "seed": {"default": 0}}, "typical_frames": [3, 8], "trigger": {"music": "redoble, efecto electrónico", "video": "corte"}},
    {"id": "glitch_vhs", "stage": "output", "level": 3, "event": "glitch", "fixed": {"style": "vhs"}, "description": "Glitch VHS: ruido, croma corrida, líneas de barrido y color lavado.", "params": {"intensity": {"default": 1.0, "min": 0.2, "max": 1.5}, "dur": {"default": 0.4, "min": 0.03, "max": 3.0}}, "typical_frames": [6, 30], "trigger": {"music": "intro, tramo lo-fi", "video": "calm"}},
    {"id": "glitch_flicker", "stage": "output", "level": 3, "event": "glitch", "fixed": {"style": "flicker"}, "description": "Parpadeo: el brillo salta más claro y más oscuro cuadro a cuadro.", "params": {"intensity": {"default": 1.0, "min": 0.2, "max": 1.5}, "dur": {"default": 0.3, "min": 0.07, "max": 2.0}, "seed": {"default": 0}}, "typical_frames": [4, 15], "trigger": {"music": "hi-hats, redoble", "video": "flash"}},
    {"id": "echo", "stage": "output", "level": 2, "description": "Estela: cada cuadro mezclado con los 4 anteriores (pesos 1, 0.75, 0.55, 0.4, 0.3). Solo se ve si hay movimiento.", "params": {"dur": {"default": 0.3, "min": 0.07, "max": 2.0}}, "typical_frames": [6, 20], "trigger": {"music": "tramo lento, voz", "video": "smear, pan"}},
    {"id": "grain", "stage": "output", "level": 1, "description": "Grano de película (ruido temporal) mientras dura.", "params": {"intensity": {"default": 1.0, "min": 0.2, "max": 2.0}, "dur": {"default": 0.5, "min": 0.07, "max": 30}}, "typical_frames": [15, 300], "trigger": {"music": "intro, outro", "video": "calm"}},
    {"id": "satpulse", "stage": "output", "level": 2, "description": "Pulso de color: la saturación sube hasta +60 % (a intensidad 1) y baja en seno durante la ventana.", "params": {"intensity": {"default": 1.0, "min": 0.2, "max": 1.5}, "dur": {"default": 0.3, "min": 0.07, "max": 1.5}}, "typical_frames": [6, 15], "trigger": {"music": "beat, bombo", "video": "impact"}},
    {"id": "shake_blur", "stage": "output", "level": 4, "event": "shake", "fixed": {"blur": 6.0}, "description": "Sacudida con desenfoque en su eje: la sacudida de siempre más un desenfoque gaussiano a lo largo del ángulo del golpe.", "params": {"intensity": {"default": 0.8, "min": 0, "max": 1.5}, "dur": {"default": 0.3, "min": 0.08, "max": 1.0}, "angle": {"default": null, "from_map": "impact.angle"}, "blur": {"default": 6.0, "min": 0, "max": 30}}, "typical_frames": [6, 12], "trigger": {"music": "golpe del bajo", "video": "impact"}},
    {"id": "overlay", "stage": "output", "level": 2, "description": "Superposición de un asset (light leak, brasas, polvo; PNG, JPG o video de assets/overlays/) en modo pantalla, suma o normal.", "params": {"image": {"default": ""}, "dur": {"default": 0.8, "min": 0.07, "max": 30}, "style": {"default": "screen", "options": ["screen", "add", "normal"]}, "opacity": {"default": 0.93, "min": 0.05, "max": 1.0}}, "typical_frames": [15, 60], "trigger": {"music": "drop, final", "video": "flash"}},
    {"id": "lens", "stage": "output", "level": 3, "description": "Distorsión de lente (barril) con aberración cromática radial opcional (rojo y verde escalados un poco más que el azul).", "params": {"intensity": {"default": 1.0, "min": -1.5, "max": 1.5}, "dur": {"default": 0.25, "min": 0.03, "max": 2.0}, "ca": {"default": 0.015, "min": 0, "max": 0.06}}, "typical_frames": [4, 15], "trigger": {"music": "golpe, entrada del drop", "video": "impact"}},
    {"id": "tilt", "stage": "output", "level": 3, "description": "Inclinación 3D: un borde del cuadro se acerca y vuelve (perspectiva, pulso en seno). left = se acerca el borde derecho.", "params": {"intensity": {"default": 1.0, "min": 0.2, "max": 2.5}, "dur": {"default": 0.4, "min": 0.07, "max": 2.0}, "style": {"default": "left", "options": ["left", "right", "up", "down"]}}, "typical_frames": [8, 20], "trigger": {"music": "transición", "video": "pan"}},
    {"id": "freeze", "stage": "output", "level": 4, "description": "Congela el cuadro de t durante dur, en tiempo de salida (lo que sigue se salta, no se atrasa). Es la base del golpe completo.", "params": {"dur": {"default": 0.3, "min": 0.03, "max": 2.0}}, "typical_frames": [6, 12], "trigger": {"music": "golpe del drop", "video": "impact"}},
    {"id": "duotone", "stage": "output", "level": 4, "description": "El cuadro como mapa de gradiente de dos colores: la luma va del oscuro al claro (rojo → cian por omisión, la ráfaga de impacto; magenta → blanco para manga).", "params": {"dur": {"default": 0.07, "min": 0.03, "max": 5.0}, "colors": {"default": ["#3a0010", "#5ef2ff"]}}, "typical_frames": [1, 30], "trigger": {"music": "golpe, verso oscuro", "video": "impact"}},
    {"id": "isolate", "stage": "output", "level": 3, "description": "Aislamiento de color: todo en gris menos un color (colorhold), que se refuerza un 30 %; el color vuelve en los últimos `fade` s.", "params": {"dur": {"default": 0.6, "min": 0.1, "max": 5.0}, "colors": {"default": ["#e02020"]}, "similarity": {"default": 0.25, "min": 0.01, "max": 1.0}, "fade": {"default": 0.2, "min": 0.03, "max": 2.0}}, "typical_frames": [12, 30], "trigger": {"music": "palabra clave, momento oscuro", "video": "impact"}},
    {"id": "glints", "stage": "output", "level": 3, "description": "Destellos de estrella de 4 puntas, nuevos en cada cuadro, alrededor de x/y.", "params": {"intensity": {"default": 1.0, "min": 0.2, "max": 2.0}, "dur": {"default": 0.2, "min": 0.03, "max": 2.0}, "x": {"default": 0.5, "from_map": "focus_at(t).cx"}, "y": {"default": 0.5, "from_map": "focus_at(t).cy"}, "seed": {"default": 0}}, "typical_frames": [3, 8], "trigger": {"music": "golpe, brillo", "video": "impact"}},
    {"id": "blur", "stage": "output", "level": 2, "description": "Desenfoque direccional (horizontal o vertical según el ángulo): la pieza del corte con desenfoque.", "params": {"dur": {"default": 0.033, "min": 0.03, "max": 1.0}, "blur": {"default": 12, "min": 1, "max": 80}, "angle": {"default": null, "from_map": "impact.angle | pan.angle"}}, "typical_frames": [1, 2], "trigger": {"music": "corte en el beat", "video": "corte"}},
    {"id": "ramp", "stage": "source", "level": 3, "field": "pieces (timing.hit_ramp)",
     "description": "Rampa de velocidad: rápido hacia el golpe y lento después, con el cuadro del golpe exacto en su beat. Con RIFE (si está) y dedupe, la parte lenta se interpola entre dibujos distintos.",
     "params": {"hit_out": {"from_map": "impact.f → beat"}, "before": {"default": "constant"}, "after": {"default": "breathe"}},
     "typical_frames": [15, 45], "trigger": {"music": "golpe en un beat", "video": "impact"}},
    {"id": "mblur", "stage": "source", "level": 2, "field": "Segment.mblur",
     "description": "Desenfoque de movimiento en cualquier ángulo (gira, desenfoca en horizontal y vuelve): en todo el plano.",
     "params": {"angle": {"default": 0, "from_map": "impact.angle | smear.angle"}, "amount": {"default": 24, "min": 1, "max": 200}},
     "typical_frames": [4, 12], "trigger": {"music": "barrido", "video": "smear"}},
    {"id": "dedupe", "stage": "source", "level": 0, "field": "Segment.dedupe",
     "description": "Con RIFE: quita los dibujos repetidos (anime en dos o tres) antes de interpolar.",
     "params": {}, "typical_frames": [0, 0], "trigger": {"music": "", "video": "held_ratio alto"}},
    {"id": "velocity", "stage": "source", "level": 3, "field": "pieces (timing.velocity)", "description": "Curva de velocidad suave (sin escalones): rise (lento → rápido), fall, dip (lento en el medio) o bump, en 8 pasos; la fuente entra justa en la duración.", "params": {"shape": {"default": "rise", "options": ["rise", "fall", "dip", "bump"]}, "steps": {"default": 8, "min": 1, "max": 24}, "low": {"default": 0.35, "min": 0.1, "max": 1.0}, "high": {"default": 1.8, "min": 1.0, "max": 4.0}}, "typical_frames": [15, 60], "trigger": {"music": "subida, frase", "video": "smear"}},
    {"id": "velocity_hit", "stage": "source", "level": 4, "field": "pieces (timing.velocity_hit)", "description": "Velocity edit alrededor del golpe: acelera hacia él y queda lento justo después, volviendo a acelerar; el cuadro del golpe cae exacto en su beat.", "params": {"hit_out": {"from_map": "impact.f → beat"}, "steps": {"default": 8}, "low": {"default": 0.35}, "high": {"default": 1.8}}, "typical_frames": [15, 60], "trigger": {"music": "golpe en un beat", "video": "impact"}},
    {"id": "split", "stage": "source", "level": 3, "field": "Segment.split", "description": "Pantalla dividida: una segunda fuente a la vez, arriba/abajo, izquierda/derecha o en diagonal, con una costura blanca. Las dos corren a la velocidad del plano.", "params": {"source": {"default": ""}, "start": {"default": 0}, "layout": {"default": "top_bottom", "options": ["top_bottom", "left_right", "diagonal"]}}, "typical_frames": [30, 90], "trigger": {"music": "verso con dos voces, contrapunto", "video": "dos personajes, plano y contraplano"}}
  ]
}
